   "position": [
    1320,
    300
   ]
  },
  {
   "parameters": {
    "command": "cd {{$('Loop languages').item.json.root}} && L={{$('Loop languages').item.json.lang}} && for k in shorts feed long; do python3 pipeline/build_html.py $L $k build/$L/$k/timeline.json build/$L/render render; done"
   },
   "id": "d0f50cb5-6e5d-4623-aafd-d5f334ae4be9",
   "name": "Build platform HTML (render)",
   "type": "n8n-nodes-base.executeCommand",
   "typeVersion": 1,
   "position": [
    1540,
    300
   ]
  },
  {
   "parameters": {
    "command": "cd {{$('Loop languages').item.json.root}} && L={{$('Loop languages').item.json.lang}} && for n in shorts-reels-tiktok-mobile:shorts shorts-reels-tiktok-pc:shorts threads-instagram-feed:feed longform-facebook-x-pc:long longform-facebook-x-mobile:long; do p=${n%%:*}; k=${n##*:}; python3 pipeline/render.py build/$L/render/lifestory-ep01-$p-$L.html build/$L/$k/narration.mp3 build/$L/out/lifestory-ep01-$p-$L.mp4; done"
   },
   "id": "defd1e71-bf9d-432d-9af5-25b6bf1af37c",
   "name": "Render 4K MP4s",
