    300
   ]
  },
  {
   "parameters": {
    "command": "cd {{$('Loop languages').item.json.root}} && python3 pipeline/build_pages.py {{$('Loop languages').item.json.lang}} build/{{$('Loop languages').item.json.lang}}/pages"
   },
   "id": "a1690965-b5df-4f28-9a6d-37ce3585c317",
   "name": "Full story + blog HTML",
