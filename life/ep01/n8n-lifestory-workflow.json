    300
   ]
  },
  {
   "parameters": {
    "command": "cd {{$('Loop languages').item.json.root}} && L={{$('Loop languages').item.json.lang}} && for k in shorts feed; do python3 pipeline/tts.py ep01/$L/$k.txt build/$L/$k $L; done"
   },
   "id": "b573a3d2-e7f2-4206-bdbd-67ba1050e24d",
   "name": "TTS shorts+feed (Typecast)",
   "type": "n8n-nodes-base.executeCommand",
   "typeVersion": 1,
   "position": [
    1100,
    300
   ]
  },
  {
   "parameters": {
    "command": "cd {{$('Loop languages').item.json.root}} && L={{$('Loop languages').item.json.lang}} && TEMPO=0.95 python3 pipeline/tts.py ep01/$L/long.txt build/$L/long $L"
   },
   "id": "eaa55752-9f51-4576-bb93-f3f40ffa98ae",
   "name": "TTS longform (Typecast, 0.95x)",
   "type": "n8n-nodes-base.executeCommand",
